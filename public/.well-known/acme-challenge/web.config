<?xml version="1.0" encoding="utf-8"?>
<!--
  Ce fichier ne vaut que pour ce dossier, et c'est tout son interet.

  Un jeton de validation ACME est un fichier SANS EXTENSION. IIS refuse
  de servir ce qu'il ne sait pas nommer : le fichier existe, les regles
  de reecriture l'epargnent, et le module statique rend malgre tout une
  404.3. L'autorite de certification lit donc une erreur la ou elle
  attend le jeton, et aucune emission ni aucun renouvellement ne peut
  aboutir.

  « fileExtension="." » designe precisement les fichiers sans extension.
  Le « clear » ne retire que les correspondances heritees dans ce
  dossier, qui ne contient jamais autre chose que des jetons.

  POURQUOI ICI ET PAS DANS LE « WEB.CONFIG » RACINE
  La premiere version posait ce meme reglage dans un bloc « location »
  du fichier racine. IIS l'a refuse et le site entier a rendu 500
  pendant trois minutes, le 2 aout 2026. La lecon n'est pas le reglage,
  qui est le bon : c'est la portee. Un « web.config » place dans le
  dossier concerne a pour rayon d'action ce seul dossier. S'il est
  refuse a son tour, « /.well-known/acme-challenge/ » repond en erreur
  et rien d'autre ne bouge — le test de fumee du deploiement le dit,
  l'accueil et les offres continuent de servir.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clear />
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
  </system.webServer>
</configuration>
